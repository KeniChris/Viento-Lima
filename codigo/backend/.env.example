# Copia este archivo a .env (solo local). Spring lo lee al arrancar desde la carpeta backend.
PORT=8080

# PostgreSQL (docker compose en codigo/docker-compose.yml)
DB_URL=jdbc:postgresql://127.0.0.1:15432/viento_lima
DB_USERNAME=viento
DB_PASSWORD=viento

# Fuente de los pronósticos: redis (publicados por Python) | fixtures (datos de prueba)
PM25_FUENTE=redis
# Vacío usa la hora real de Lima. El reloj fijo se usa en pruebas con fixtures.
PM25_RELOJ_FIJO=

# Solo se usa con PM25_FUENTE=redis (misma variable que codigo/cargar_redis.py)
PM25_REDIS_URL=redis://127.0.0.1:6379/0
PM25_MODELO_VERSION=pm25-2
