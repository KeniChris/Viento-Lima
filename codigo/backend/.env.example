# Copia este archivo a .env (solo local). Spring lo lee al arrancar desde la carpeta backend.
PORT=8080

# PostgreSQL (docker compose en codigo/docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5432/viento_lima
DB_USERNAME=viento
DB_PASSWORD=viento

# Fuente de los pronósticos: fixtures (datos de prueba) | redis (lector real)
PM25_FUENTE=fixtures
# Reloj fijo para la demostración con fixtures (déjalo vacío para usar la hora real de Lima)
PM25_RELOJ_FIJO=2024-11-15T08:15:00-05:00

# Solo se usa con PM25_FUENTE=redis (misma variable que codigo/cargar_redis.py)
PM25_REDIS_URL=redis://127.0.0.1:6379/0
PM25_VERSION_MODELO=pm25-1
